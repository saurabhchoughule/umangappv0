# Copy to .env for local dev (never commit .env)
# Long random string used to sign login sessions:  openssl rand -base64 48
AUTH_SECRET=
# One-time key needed to create the very first admin on first run:  openssl rand -hex 16
ADMIN_SETUP_KEY=
# Production only (Turso/libSQL). Leave empty locally to use data/app.db
DATABASE_URL=
DATABASE_AUTH_TOKEN=
